# Planning template only. Secret references must be resolved by your deployment
# secret manager into mounted files; never copy values into frontend variables.
ASSISTANT_ENV=staging
ASSISTANT_DEMO=false
ASSISTANT_UI_ORIGIN=https://app.staging.example.com
WIDGET_PUBLIC_ORIGIN=https://widget.staging.example.com
WIDGET_DEMO_SITE_ORIGINS=
WIDGET_DEMO_SITE_TARGETS={}
AUTH0_DOMAIN=identity.staging.example.com
AUTH0_AUDIENCE=https://api.staging.example.com
ASSISTANT_DATABASE=/data/assistant.sqlite3
ASSISTANT_ENCRYPTION_KEY_FILE=/run/secrets/tenant-encryption
# Existing backup runtime reads ASSISTANT_BACKUP_ENCRYPTION_KEY from the
# environment. Inject it directly from the backup-encryption secret reference;
# no value is included here. File-based backup key loading is not implemented.
LLM_ENDPOINT=http://private-inference:8080/v1
LLM_API_KEY_FILE=/run/secrets/inference-key
STT_ENDPOINT=http://private-stt:8000
TTS_ENDPOINT=http://private-tts:8000
SPEECH_API_KEY_FILE=/run/secrets/speech-key
# Source references for your deployment planner, not runtime credentials:
# tenant-encryption -> secret-manager://staging/tenant-encryption
# backup-encryption -> secret-manager://staging/backup-encryption
# inference-key -> secret-manager://staging/inference-key
# speech-key -> secret-manager://staging/speech-key
# Mock-only widget promotion is not a production integration approval.
