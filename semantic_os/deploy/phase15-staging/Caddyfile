assistant-staging.ontelyx.tech {
  encode gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "microphone=(), camera=(), geolocation=()"
  }
  reverse_proxy widget:8080
}
assistant-demo.ontelyx.tech {
  encode gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "microphone=(), camera=(), geolocation=()"
  }
  reverse_proxy widget:8081
}
assistant-admin-staging.ontelyx.tech {
  encode gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "microphone=(), camera=(), geolocation=()"
  }
  handle /backend/* {
    uri strip_prefix /backend
    reverse_proxy backend:8000
  }
  handle {
    reverse_proxy frontend:8080
  }
}
