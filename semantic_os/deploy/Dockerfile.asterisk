FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ARG ASTERISK_PACKAGE_VERSION=1:20.6.0~dfsg+~cs6.13.40431414-2build5
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends asterisk=${ASTERISK_PACKAGE_VERSION} && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /var/run/asterisk /var/log/asterisk && chown -R asterisk:asterisk /var/run/asterisk /var/log/asterisk /var/spool/asterisk /var/lib/asterisk
USER asterisk
EXPOSE 5060/udp
CMD ["asterisk","-f","-vv","-g"]
