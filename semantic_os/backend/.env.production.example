# Supply verified identity, provision memberships, and mount a persistent database.
ASSISTANT_ENV=production
ASSISTANT_DEMO=false
ASSISTANT_DATABASE=/data/assistant.sqlite3
ASSISTANT_ENCRYPTION_KEY=replace-me-with-a-managed-fernet-key
ASSISTANT_UI_ORIGIN=https://replace-me.example.invalid
ASSISTANT_PLATFORM_ADMIN_SUBJECTS=replace-me-with-verified-subjects
ASSISTANT_ALLOW_MOCK_BILLING=false
ASSISTANT_MESSAGING_WORKER_ENABLED=true
ASSISTANT_BACKUP_ENABLED=true
ASSISTANT_BACKUP_DIRECTORY=/backups
ASSISTANT_BACKUP_ENCRYPTION_KEY=replace-me-with-a-separate-managed-backup-key
ASSISTANT_BACKUP_INTERVAL_SECONDS=86400
AUTH0_DOMAIN=replace-me.example.invalid
AUTH0_AUDIENCE=replace-me-api-audience
