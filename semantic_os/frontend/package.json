{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../security/scan-secrets.mjs src index.html vite.config.ts && vite build && node ../security/scan-secrets.mjs dist",
    "check:production-auth": "node scripts/validate-production-auth-config.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs ../security/scan-secrets.test.mjs"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.25.0",
    "vue": "^3.5.43",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.43",
    "eslint": "^9",
    "eslint-plugin-vue": "^10.11.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.12",
    "vue-eslint-parser": "^10.4.1"
  }
}
