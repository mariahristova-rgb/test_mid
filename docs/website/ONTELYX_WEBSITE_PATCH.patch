diff --git a/src/components/AiAssistantEntry.vue b/src/components/AiAssistantEntry.vue
new file mode 100644
index 0000000..30550b6
--- /dev/null
+++ b/src/components/AiAssistantEntry.vue
@@ -0,0 +1,189 @@
+<script setup lang="ts">
+import { computed, nextTick, onUnmounted, ref } from "vue";
+import { publicConfig, widgetConfigured } from "../config";
+import { assistantLabels, type AssistantLocale } from "../assistant-labels";
+const props = withDefaults(
+  defineProps<{ floating?: boolean; initialLocale?: AssistantLocale }>(),
+  { floating: false, initialLocale: "en-US" },
+);
+const emit = defineEmits<{ started: [] }>();
+const locale = ref<AssistantLocale>(props.initialLocale),
+  open = ref(false),
+  status = ref<"idle" | "loading" | "ready" | "error">("idle");
+const labels = computed(() => assistantLabels[locale.value]);
+const connected = ref(false);
+const mount = ref<HTMLElement>(),
+  trigger = ref<HTMLButtonElement>();
+let script: HTMLScriptElement | undefined,
+  timer: ReturnType<typeof setTimeout> | undefined;
+let disposed = false;
+function dispose() {
+  clearTimeout(timer);
+  script?.dispatchEvent(new Event("testmid-widget-destroy"));
+  mount.value?.replaceChildren();
+  script = undefined;
+  connected.value = false;
+}
+async function close() {
+  open.value = false;
+  await nextTick();
+  trigger.value?.focus();
+}
+async function start() {
+  if (!widgetConfigured) return;
+  open.value = true;
+  await nextTick();
+  if (script || disposed) return;
+  status.value = "loading";
+  emit("started");
+  script = document.createElement("script");
+  script.async = true;
+  script.src = publicConfig.widgetOrigin + "/widget/assets/v1.js";
+  script.dataset.assistantId = publicConfig.assistantId;
+  script.dataset.locale = locale.value;
+  script.dataset.mode = "embedded";
+  script.referrerPolicy = "no-referrer";
+  script.addEventListener("testmid-widget-ready", () => {
+    clearTimeout(timer);
+    connected.value = true;
+    status.value = "ready";
+  });
+  script.addEventListener("testmid-widget-error", () => {
+    clearTimeout(timer);
+    status.value = "error";
+  });
+  script.addEventListener("testmid-widget-close", () => void close());
+  script.addEventListener("testmid-widget-expired", () => {
+    clearTimeout(timer);
+    status.value = "error";
+  });
+  script.addEventListener("testmid-widget-reset", () => {
+    dispose();
+    status.value = "idle";
+    void close();
+  });
+  script.addEventListener("error", () => {
+    clearTimeout(timer);
+    status.value = "error";
+  });
+  timer = setTimeout(() => {
+    status.value = "error";
+  }, 20000);
+  mount.value?.append(script);
+}
+async function retry() {
+  dispose();
+  status.value = "idle";
+  await start();
+}
+onUnmounted(() => {
+  disposed = true;
+  dispose();
+});
+</script>
+<template>
+  <section class="assistant-entry" :class="{ floating }" :lang="locale">
+    <button
+      ref="trigger"
+      class="button assistant-launch"
+      :aria-expanded="open"
+      @click="open ? close() : start()"
+      :disabled="!widgetConfigured"
+    >
+      {{ floating ? labels.title : labels.open }}
+    </button>
+    <p v-if="!widgetConfigured && !floating" role="status">
+      {{ labels.unavailable }}
+    </p>
+    <div
+      v-show="open"
+      class="assistant-panel"
+      :role="floating ? 'dialog' : 'region'"
+      :aria-label="labels.title"
+      @keydown.esc="close"
+    >
+      <div class="assistant-toolbar">
+        <label
+          >{{ labels.language }}
+          <select v-model="locale" :disabled="!!script">
+            <option value="en-US">English</option>
+            <option value="bg-BG">Български</option>
+          </select></label
+        ><button type="button" @click="close">{{ labels.close }}</button>
+      </div>
+      <p v-if="status === 'loading'" role="status">{{ labels.loading }}</p>
+      <p v-if="status === 'ready'" role="status">{{ labels.ready }}</p>
+      <div v-if="status === 'error'" role="alert">
+        <p>{{ labels.error }}</p>
+        <button class="button" @click="retry">{{ labels.retry }}</button
+        ><RouterLink to="/contact">{{ labels.contact }}</RouterLink>
+      </div>
+      <div
+        ref="mount"
+        class="assistant-mount"
+        :class="{ failed: status === 'error' && !connected }"
+      />
+    </div>
+  </section>
+</template>
+<style scoped>
+.assistant-launch {
+  min-height: 48px;
+}
+.assistant-panel {
+  background: var(--surface);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius);
+  padding: var(--space-small);
+  margin-top: 16px;
+}
+.assistant-toolbar {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+.assistant-toolbar button,
+.assistant-toolbar select {
+  min-height: 44px;
+  padding: 8px;
+  background: var(--surface-alt);
+  color: var(--text);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius);
+}
+.assistant-mount {
+  height: min(640px, calc(100dvh - 220px));
+  min-height: 280px;
+  margin-top: 12px;
+}
+.assistant-mount.failed {
+  display: none;
+}
+.floating .assistant-launch {
+  position: fixed;
+  right: 20px;
+  bottom: 20px;
+  z-index: 110;
+}
+.floating .assistant-panel {
+  position: fixed;
+  right: 16px;
+  bottom: 84px;
+  width: min(440px, calc(100vw - 32px));
+  max-height: calc(100dvh - 112px);
+  overflow: auto;
+  z-index: 110;
+  box-shadow: 0 8px 30px #0005;
+}
+.floating .assistant-mount {
+  height: min(580px, calc(100dvh - 230px));
+}
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none;
+    scroll-behavior: auto;
+  }
+}
+</style>
