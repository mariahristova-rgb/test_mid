+import { afterEach, describe, expect, it, vi } from "vitest";
+import { mount, flushPromises } from "@vue/test-utils";
+import { readPublicConfig } from "../scripts/public-config";
+import { assistantLabels } from "../src/assistant-labels";
+vi.mock("../src/config", () => ({
+  widgetConfigured: true,
+  publicConfig: {
+    widgetOrigin: "https://widget.staging.example.com",
+    assistantId: "wdg_11111111111111111111111111111111",
+  },
+}));
+import Entry from "../src/components/AiAssistantEntry.vue";
+const options = {
+  global: { stubs: { RouterLink: { template: "<a><slot /></a>" } } },
+};
+afterEach(() => {
+  vi.useRealTimers();
+  document.body.replaceChildren();
+});
+describe("website entry, without executing external iframe scripts", () => {
+  it("keeps expired chat deletion reachable and resets the mount after clear", async () => {
+    const wrapper = mount(Entry, options);
+    await wrapper.get("button").trigger("click");
+    await flushPromises();
+    const script = wrapper.get("script").element;
+    script.dispatchEvent(new Event("testmid-widget-ready"));
+    await flushPromises();
+    script.dispatchEvent(new Event("testmid-widget-expired"));
+    await flushPromises();
+    expect(wrapper.get(".assistant-mount").classes()).not.toContain("failed");
+    script.dispatchEvent(new Event("testmid-widget-reset"));
+    await flushPromises();
+    expect(wrapper.find("script").exists()).toBe(false);
+    expect(wrapper.get(".assistant-launch").attributes("aria-expanded")).toBe(
+      "false",
+    );
+    wrapper.unmount();
+  });
+  it("loads one shared widget only after user action and cleans up on unmount", async () => {
+    const wrapper = mount(Entry, { ...options, attachTo: document.body });
+    expect(wrapper.find("script").exists()).toBe(false);
+    await wrapper.get("button").trigger("click");
+    await flushPromises();
+    const script = wrapper.get("script").element;
+    expect(script.getAttribute("src")).toBe(
+      "https://widget.staging.example.com/widget/assets/v1.js",
+    );
+    expect(script.getAttribute("data-mode")).toBe("embedded");
+    const cleanup = vi.fn();
+    script.addEventListener("testmid-widget-destroy", cleanup);
+    await wrapper.get(".assistant-toolbar button").trigger("click");
+    await wrapper.get(".assistant-launch").trigger("click");
+    expect(wrapper.findAll("script")).toHaveLength(1);
+    wrapper.unmount();
+    expect(cleanup).toHaveBeenCalledOnce();
+  });
+  it("reports readiness only after iframe session confirmation, not script load", async () => {
+    const wrapper = mount(Entry, options);
+    await wrapper.get("button").trigger("click");
+    await flushPromises();
+    const script = wrapper.get("script").element;
+    script.dispatchEvent(new Event("load"));
+    await flushPromises();
+    expect(wrapper.text()).toContain("Connecting");
+    script.dispatchEvent(new Event("testmid-widget-ready"));
+    await flushPromises();
+    expect(wrapper.text()).toContain("Assistant connected");
+    wrapper.unmount();
+  });
+  it("supports Bulgarian and safe retry of a failed bootstrap", async () => {
+    const wrapper = mount(Entry, {
+      ...options,
+      props: { initialLocale: "bg-BG" },
+    });
+    await wrapper.get("button").trigger("click");
+    await flushPromises();
+    wrapper.get("script").element.dispatchEvent(new Event("error"));
+    await flushPromises();
+    expect(wrapper.get('[role="alert"]').text()).toContain("не е достъпен");
+    await wrapper.get('[role="alert"] button').trigger("click");
+    await flushPromises();
+    expect(wrapper.findAll("script")).toHaveLength(1);
+    expect(wrapper.get("script").attributes("data-locale")).toBe("bg-BG");
+    wrapper.unmount();
+  });
+  it("has no microphone capture or private authorization in website presentation", () => {
+    const wrapper = mount(Entry, options);
+    expect(wrapper.find("audio").exists()).toBe(false);
+    expect(wrapper.html()).not.toContain("Authorization");
+    wrapper.unmount();
+  });
+});
+describe("public widget configuration boundary", () => {
+  it.each([
+    "http://private-inference:8080",
+    "https://widget.example/keys",
+    "javascript:alert(1)",
+    "https://user:pass@widget.example",
+    "https://widget.example/#x",
+  ])("rejects unsafe widget configuration %s", (origin) => {
+    expect(() =>
+      readPublicConfig({
+        VITE_ASSISTANT_WIDGET_ORIGIN: origin,
+        VITE_ASSISTANT_PUBLIC_ID: "wdg_11111111111111111111111111111111",
+      }),
+    ).toThrow();
+  });
+  it("rejects loopback in hosted builds and excludes secret-shaped extra fields", () => {
+    expect(() =>
+      readPublicConfig({
+        NETLIFY: "true",
+        VITE_ASSISTANT_WIDGET_ORIGIN: "http://127.0.0.1:3020",
+        VITE_ASSISTANT_PUBLIC_ID: "wdg_11111111111111111111111111111111",
+      }),
+    ).toThrow();
+    const result = readPublicConfig({
+      VITE_ASSISTANT_WIDGET_ORIGIN: "https://widget.staging.example.com",
+      VITE_ASSISTANT_PUBLIC_ID: "wdg_11111111111111111111111111111111",
+      VITE_ASSISTANT_API_KEY: "private-fixture",
+    });
+    expect(JSON.stringify(result)).not.toContain("private-fixture");
+    expect(Object.keys(assistantLabels["en-US"]).sort()).toEqual(
+      Object.keys(assistantLabels["bg-BG"]).sort(),
+    );
+  });
+});
