# Placeholder values only. Load into the process explicitly; legacy env files are ignored.
ASSISTANT_ENV=development
ASSISTANT_DATABASE=.assistant-data/assistant.sqlite3
ASSISTANT_DEMO=false
ASSISTANT_DEMO_TOKEN=replace-me-with-a-random-local-development-token
ASSISTANT_ENCRYPTION_KEY=replace-me-with-a-fernet-key
ASSISTANT_UI_ORIGIN=http://127.0.0.1:3000
ASSISTANT_ENABLE_LIVE_VOICE=false
ASSISTANT_ENABLE_LIVE_MESSAGING=false
ASSISTANT_MESSAGING_WORKER_ENABLED=false
ASSISTANT_ALLOW_MOCK_BILLING=false
ASSISTANT_PLATFORM_ADMIN_SUBJECTS=replace-me-with-explicit-verified-subjects
ASSISTANT_BACKUP_ENABLED=false
ASSISTANT_BACKUP_ENCRYPTION_KEY=replace-me-with-a-separate-managed-fernet-key
ASSISTANT_BACKUP_DIRECTORY=artifacts/backups
ASSISTANT_BACKUP_INTERVAL_SECONDS=86400
ASSISTANT_BACKUP_RETENTION_DAYS=7
ASSISTANT_RPO_SECONDS=86400
ASSISTANT_RTO_SECONDS=3600
# Enable the bounded single-process worker explicitly for signed inbound/outbox and reminder jobs.
# Never put telephony/speech secrets in VITE_* variables. Configure encrypted tenant connections through the admin API.
AUTH0_DOMAIN=replace-me.example.invalid
AUTH0_AUDIENCE=replace-me-api-audience
VITE_API_URL=http://127.0.0.1:8000
VITE_AUTH0_DOMAIN=replace-me.example.invalid
VITE_AUTH0_CLIENT_ID=replace-me-public-client-id
VITE_AUTH0_AUDIENCE=replace-me-api-audience

# Optional self-hosted voice. Supply existing artifacts/endpoint; no download fallback.
LLM_PROVIDER=mock
LLM_MODEL=qwen3-4b
LLM_SERVED_MODEL=Qwen3-4B
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MAX_TOKENS=256
LLM_CONTEXT_LENGTH=4096
LLM_TIMEOUT=20
LLM_ALLOW_PRIVATE_HTTP=false
SELF_HOSTED_VOICE_ENABLED=false
LOCAL_SPEECH_CONFIG=
ARI_ENDPOINT=
ARI_USERNAME=
ARI_PASSWORD=
ARI_TENANT_ID=smilecare-demo
ARI_ASSISTANT_ID=default
ARI_SERVICE_SUBJECT=smilecare-demo-admin
VOICE_RTP_ADVERTISE_HOST=
VOICE_RTP_BIND_HOST=0.0.0.0
ASTERISK_RTP_HOST=
